{
  "name": "@epicauth/sdk",
  "version": "1.0.2",
  "description": "EpicAuth SDK for Node.js and Bun",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EpicAuth/EpicAuth-TS-SDK.git"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "bunx tsc --noEmit",
    "dev": "bun --watch src/index.ts"
  },
  "private": false,
  "license": "Elastic-2.0",
  "dependencies": {
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  }
}